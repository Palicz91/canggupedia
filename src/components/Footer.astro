---

<footer class="bg-gray-900 text-white py-12 mt-16">
  <div class="container mx-auto px-4">
    <div class="mb-12">
      <h3 class="text-3xl font-display font-bold text-center mb-6">
        Follow @thecanggupedia
      </h3>
      <div class="flex flex-col md:flex-row items-center justify-center gap-6">
        <div class="flex flex-col gap-4">
          <a
            href="https://instagram.com/thecanggupedia"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center space-x-3 bg-gradient-to-br from-pink-500 to-purple-600 text-white px-8 py-4 rounded-full font-bold hover:shadow-lg transition-all hover:scale-105"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            <span>Follow on Instagram</span>
          </a>
          <a
            href="https://linktr.ee/thecanggupedia"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center space-x-3 bg-gradient-tropical text-white px-8 py-4 rounded-full font-bold hover:shadow-lg transition-all hover:scale-105"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
            <span>All Our Links</span>
          </a>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-700 pt-8 mb-8"></div>

    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <div>
        <h3 class="text-2xl font-display font-bold mb-4 bg-gradient-tropical bg-clip-text text-transparent">
          The Canggupedia
        </h3>
        <p class="text-gray-300 mb-4">
          Your ultimate insider guide to the best of Bali. Discover hidden gems, local favorites, and must-visit spots.
        </p>
        <div class="flex space-x-4">
          <a
            href="https://instagram.com/thecanggupedia"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-gradient-to-br from-pink-500 to-purple-600 p-3 rounded-full hover:scale-110 transition-transform"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
          <a
            href="mailto:hello@thecanggupedia.com"
            class="bg-gradient-sunset p-3 rounded-full hover:scale-110 transition-transform"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="font-display font-bold text-lg mb-4">Quick Links</h4>
        <div class="space-y-2">
          <a href="/canggu" class="block text-gray-300 hover:text-sunset-coral transition-colors">Explore Canggu</a>
          <a href="/uluwatu" class="block text-gray-300 hover:text-sunset-coral transition-colors">Explore Uluwatu</a>
          <a href="/events" class="block text-gray-300 hover:text-sunset-coral transition-colors">Events</a>
          <a href="/happy-hour" class="block text-gray-300 hover:text-sunset-coral transition-colors">Happy Hour</a>
          <a href="/daily-promos" class="block text-gray-300 hover:text-sunset-coral transition-colors">Daily Promos</a>
          <a href="/contact" class="block text-gray-300 hover:text-sunset-coral transition-colors">Contact Us</a>
        </div>
      </div>

      <div>
        <h4 class="font-display font-bold text-lg mb-4">Follow Us</h4>
        <p class="text-gray-300 mb-4">
          Stay updated with the latest events, new venues, and exclusive deals!
        </p>
        <a
          href="https://instagram.com/thecanggupedia"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-gradient-to-br from-pink-500 to-purple-600 text-white px-6 py-3 rounded-full font-bold hover:shadow-lg transition-all hover:scale-105"
        >
          Follow on Instagram
        </a>
        <div class="mt-6 flex items-start space-x-2 text-gray-300">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
          <span>Based in Canggu & Uluwatu, Bali</span>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-700 pt-8">
      <div class="grid md:grid-cols-2 gap-4">
        <div class="text-gray-400 text-sm">
          &copy; 2026 The Canggupedia. All rights reserved.
        </div>
        <div class="text-gray-400 text-sm md:text-right">
          Made with love in Bali
        </div>
      </div>
    </div>
  </div>
</footer>
