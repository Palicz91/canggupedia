---
const partners = [
  {
    src: "https://yltgnuauemngtddujata.supabase.co/storage/v1/object/public/website/images%20(2).png",
    alt: "Partner 1",
  },
  {
    src: "https://yltgnuauemngtddujata.supabase.co/storage/v1/object/public/website/images%20(3).jpeg",
    alt: "Partner 2",
  },
  {
    src: "https://yltgnuauemngtddujata.supabase.co/storage/v1/object/public/website/1670487571787.jpeg",
    alt: "Partner 3",
  },
];
---

<section class="bg-white py-10 overflow-hidden relative">
  <div class="container mx-auto px-6 text-center">
    <div class="relative w-full overflow-hidden">
      <div class="flex items-center gap-16 animate-marquee whitespace-nowrap">
        {[...partners, ...partners].map((partner) => (
          <img
            src={partner.src}
            alt={partner.alt}
            width="180"
            height="100"
            class="object-contain drop-shadow-lg inline-block"
            loading="lazy"
          />
        ))}
      </div>
    </div>
  </div>
</section>
