---
import BaseLayout from '../layouts/BaseLayout.astro';
import promosData from '../data/daily-promos.json';
import PromoCard, { type Promo } from '../components/PromoCard.astro';
import { DAYS, promoDays, promosForDay } from '../lib/promo-days';
type DailyPromo = Promo & { day?: string; days?: string[] };
const dailyPromos: DailyPromo[] = promosData.daily_promos;
// Each day's own order (set in the admin's order screen); a promo on two days has a place on each.
const promoOrder = (promosData as { promo_order?: Record<string, string[]> }).promo_order;

const daysOfWeek = DAYS;
---

<BaseLayout
  title="Daily Promos in Bali | The Canggupedia"
  description="Find the best daily promos in Canggu and Uluwatu. Margarita Mondays, Taco Tuesdays, and more."
>
  <div class="min-h-screen bg-gradient-to-br from-purple-100 to-pink-100">
    <div class="container mx-auto px-4 py-12">
      <div class="text-center mb-12">
        <h1 class="text-5xl md:text-6xl font-display font-bold text-gray-800 mb-4">
          What's On
        </h1>
        <p id="promos-subtitle" class="text-xl text-gray-600">
          Monday to Sunday Promos
        </p>
      </div>

      <!-- Day buttons like the Party / Bars / Beach Clubs ones on the venue pages (Ivan, 2026-11-10):
           without them, checking Thursday meant scrolling past Monday to Wednesday. -->
      <div id="day-chips" class="flex flex-wrap justify-center gap-2 md:gap-3 mb-12" hidden={dailyPromos.length === 0}>
        <button type="button" class="day-chip px-4 md:px-6 py-2 rounded-full font-semibold transition-all cursor-pointer bg-gradient-tropical text-white shadow-lg" data-day="all" aria-pressed="true">
          All
        </button>
        {daysOfWeek.filter((day) => dailyPromos.some((promo) => promoDays(promo).includes(day))).map((day) => (
          <button type="button" class="day-chip px-4 md:px-6 py-2 rounded-full font-semibold transition-all cursor-pointer bg-white text-gray-700 hover:bg-gray-100" data-day={day} aria-pressed="false">
            {day}
          </button>
        ))}
      </div>

      {daysOfWeek.map((day) => {
        const dayPromos = promosForDay(dailyPromos, promoOrder, day);
        if (dayPromos.length === 0) return null;

        return (
          <div class="mb-12 day-section" data-day={day}>
            <h2 class="text-3xl font-display font-bold text-gray-800 mb-6 text-center">
              {day}
            </h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
              {dayPromos.map((promo) => (
                <PromoCard promo={promo} />
              ))}
            </div>
          </div>
        );
      })}

      <div id="empty-state" class="text-center py-16" hidden={dailyPromos.length > 0}>
        <p id="empty-state-text" class="text-xl text-gray-600">No daily promos available yet. Check back soon!</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { showsInArea } from '../lib/areas';

  const ACTIVE = ['bg-gradient-tropical', 'text-white', 'shadow-lg'];
  const INACTIVE = ['bg-white', 'text-gray-700', 'hover:bg-gray-100'];

  const params = new URLSearchParams(window.location.search);
  const location = params.get('location');
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.day-section'));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.day-chip'));
  const empty = document.getElementById('empty-state');
  const emptyText = document.getElementById('empty-state-text');

  // The area never changes on this page, so hide the other area's cards once and count per day.
  const cardsPerDay = new Map<string, number>();
  for (const section of sections) {
    let shown = 0;
    section.querySelectorAll<HTMLElement>('.promo-card').forEach((card) => {
      const inArea = !location || showsInArea(card.getAttribute('data-location'), location);
      card.style.display = inArea ? '' : 'none';
      if (inArea) shown++;
    });
    cardsPerDay.set(section.dataset.day || '', shown);
  }

  if (location) {
    const name = location.charAt(0).toUpperCase() + location.slice(1);
    const subtitle = document.getElementById('promos-subtitle');
    if (subtitle) subtitle.textContent = `${name} - Monday to Sunday Promos`;
  }

  // A day with nothing in this area gets no button, so no button leads to an empty page.
  for (const chip of chips) {
    const day = chip.dataset.day || '';
    if (day !== 'all' && !cardsPerDay.get(day)) chip.hidden = true;
  }

  function show(activeDay: string) {
    for (const section of sections) {
      const day = section.dataset.day || '';
      const visible = (cardsPerDay.get(day) || 0) > 0 && (activeDay === 'all' || day === activeDay);
      section.style.display = visible ? '' : 'none';
    }
    for (const chip of chips) {
      const on = chip.dataset.day === activeDay;
      chip.classList.remove(...(on ? INACTIVE : ACTIVE));
      chip.classList.add(...(on ? ACTIVE : INACTIVE));
      chip.setAttribute('aria-pressed', String(on));
    }
  }

  chips.forEach((chip) => chip.addEventListener('click', () => show(chip.dataset.day || 'all')));
  show('all');

  const anyInArea = Array.from(cardsPerDay.values()).some((n) => n > 0);
  if (!anyInArea) {
    const chipRow = document.getElementById('day-chips');
    if (chipRow) chipRow.hidden = true;
    if (empty && emptyText && location) {
      emptyText.textContent = 'Nothing in this area yet.';
      empty.hidden = false;
    }
  }
</script>
