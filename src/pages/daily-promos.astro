---
import BaseLayout from '../layouts/BaseLayout.astro';
import promosData from '../data/daily-promos.json';
import { toHref } from '../lib/links';
import { cdnImage } from '../lib/images';
// The admin writes optional fields only once someone fills them in, so the JSON alone can't type them.
interface DailyPromo {
  id: string;
  day: string;
  title: string;
  venue: string;
  description: string;
  imageUrl?: string;
  location: string;
  venueInstagram?: string;
  googleMapsUrl?: string;
}
const dailyPromos: DailyPromo[] = promosData.daily_promos;

const daysOfWeek = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
---

<BaseLayout
  title="Daily Promos & Deals in Bali | The Canggupedia"
  description="Find the best daily promos and special deals in Canggu and Uluwatu. Margarita Mondays, Taco Tuesdays, and more."
>
  <div class="min-h-screen bg-gradient-to-br from-purple-100 to-pink-100">
    <div class="container mx-auto px-4 py-12">
      <div class="text-center mb-12">
        <h1 class="text-5xl md:text-6xl font-display font-bold text-gray-800 mb-4">
          What's On
        </h1>
        <p id="promos-subtitle" class="text-xl text-gray-600">
          Daily Promos & Special Deals
        </p>
      </div>

      {daysOfWeek.map((day) => {
        const dayPromos = dailyPromos.filter((promo) => promo.day === day);
        if (dayPromos.length === 0) return null;

        return (
          <div class="mb-12 day-section" data-day={day}>
            <h2 class="text-3xl font-display font-bold text-gray-800 mb-6 text-center">
              {day}
            </h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
              {dayPromos.map((promo) => (
                <div class="bg-white rounded-2xl shadow-lg overflow-hidden card-hover promo-card" data-location={promo.location}>
                  <div class="relative h-48">
                    <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-amber-100 to-orange-100" aria-hidden="true">
                      <img src="/images/pediafamlogo.webp" alt="" class="w-24 max-w-[60%] opacity-40" />
                    </div>
                    {promo.imageUrl && (
                      <button
                        type="button"
                        class="image-zoom relative block w-full h-full cursor-zoom-in"
                        data-zoom={cdnImage(promo.imageUrl, 1200)}
                        aria-label={`Show the full picture: ${promo.title}`}
                      >
                        <img
                          src={cdnImage(promo.imageUrl, 800)}
                          alt={promo.title}
                          class="w-full h-full object-cover"
                          loading="lazy"
                          onerror="this.parentElement.remove()"
                        />
                      </button>
                    )}
                  </div>
                  <div class="p-6">
                    <h3 class="font-display font-bold text-2xl text-gray-800 mb-2">
                      {promo.title}
                    </h3>
                    <p class="text-sunset-orange font-bold text-lg mb-3">
                      {promo.venue}
                    </p>
                    <p class="text-gray-600 mb-6">{promo.description}</p>
                    <div class="flex flex-wrap gap-2">
                      {toHref(promo.googleMapsUrl) && (
                        <a
                          href={toHref(promo.googleMapsUrl)}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center space-x-2 bg-sunset-orange text-white py-2 px-4 rounded-xl hover:bg-sunset-coral transition-colors font-semibold"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
                          <span>Map</span>
                        </a>
                      )}
                      {toHref(promo.venueInstagram, 'instagram') && (
                        <a
                          href={toHref(promo.venueInstagram, 'instagram')}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center space-x-2 bg-pink-500 text-white py-2 px-4 rounded-xl hover:bg-pink-600 transition-colors font-semibold"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                          <span>View Venue</span>
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        );
      })}

      <div id="empty-state" class="text-center py-16" hidden={dailyPromos.length > 0}>
        <p id="empty-state-text" class="text-xl text-gray-600">No daily promos available yet. Check back soon for great deals!</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const location = params.get('location');
  if (location) {
    const name = location.charAt(0).toUpperCase() + location.slice(1);
    const subtitle = document.getElementById('promos-subtitle');
    if (subtitle) subtitle.textContent = `${name} - Daily Promos & Special Deals`;

    document.querySelectorAll<HTMLElement>('.promo-card').forEach((card) => {
      if (card.getAttribute('data-location') !== location) card.style.display = 'none';
    });

    document.querySelectorAll<HTMLElement>('.day-section').forEach((section) => {
      const visible = Array.from(section.querySelectorAll<HTMLElement>('.promo-card')).some((c) => c.style.display !== 'none');
      if (!visible) section.style.display = 'none';
    });

    const anyVisible = Array.from(document.querySelectorAll<HTMLElement>('.promo-card')).some((c) => c.style.display !== 'none');
    const empty = document.getElementById('empty-state');
    const emptyText = document.getElementById('empty-state-text');
    if (empty && emptyText && !anyVisible) {
      emptyText.textContent = 'Nothing in this area yet.';
      empty.hidden = false;
    }
  }
</script>
