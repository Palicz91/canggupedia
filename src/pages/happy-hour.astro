---
import BaseLayout from '../layouts/BaseLayout.astro';
import happyHoursData from '../data/happy-hours.json';
const happyHours = happyHoursData.happy_hours;
---

<BaseLayout
  title="Happy Hour Deals in Bali - Best Drink Specials | The Canggupedia"
  description="Find the best happy hour deals in Canggu and Uluwatu. Discounted cocktails, beers, and more."
>
  <div class="min-h-screen bg-gradient-to-br from-amber-100 to-orange-100">
    <div class="container mx-auto px-4 py-12">
      <div class="text-center mb-12">
        <h1 class="text-5xl md:text-6xl font-display font-bold text-gray-800 mb-4">
          Happy Hour
        </h1>
        <p class="text-xl text-gray-600">
          Best drink deals around town
        </p>
      </div>

      {happyHours.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
          {happyHours.map((hh) => (
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden card-hover">
              <div class="relative h-48">
                <img
                  src={hh.imageUrl}
                  alt={hh.venue}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="p-6">
                <h3 class="font-display font-bold text-2xl text-gray-800 mb-3">
                  {hh.venue}
                </h3>

                <div class="space-y-3 mb-6">
                  <div class="flex items-start space-x-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sunset-orange mt-0.5 flex-shrink-0"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <div>
                      <p class="font-semibold text-gray-700">{hh.time}</p>
                      <p class="text-sm text-gray-600">
                        {Array.isArray(hh.days) ? hh.days.join(', ') : hh.days}
                      </p>
                    </div>
                  </div>

                  <div class="bg-gradient-tropical text-white px-4 py-3 rounded-xl font-bold text-center">
                    {hh.offer}
                  </div>
                </div>

                <div class="flex space-x-2">
                  <a
                    href={hh.googleMapsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 flex items-center justify-center space-x-2 bg-sunset-orange text-white py-2 px-4 rounded-xl hover:bg-sunset-coral transition-colors font-semibold"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
                    <span>Map</span>
                  </a>
                  <a
                    href={hh.instagramUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 flex items-center justify-center space-x-2 bg-pink-500 text-white py-2 px-4 rounded-xl hover:bg-pink-600 transition-colors font-semibold"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                    <span>IG</span>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-xl text-gray-600 mb-4">No happy hours available yet.</p>
          <p class="text-gray-500">Check back soon for great deals!</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
