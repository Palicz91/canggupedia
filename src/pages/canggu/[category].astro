---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VenueGrid from '../../components/VenueGrid.tsx';
const venueModules = import.meta.glob('../../data/venues/**/*.json', { eager: true, import: 'default' });
const venues = Object.entries(venueModules).map(([path, v]) => {
  const slug = path.split('/').pop()!.replace(/\.json$/, '');
  return { ...(v as any), slug, id: (v as any).id || slug };
});
import { categoryConfigs } from '../../data/category-config';
import { subOrdersFor } from '../../lib/venues';
import venueOrder from '../../data/venue-order/canggu.json';

export function getStaticPaths() {
  const categories = Object.keys(categoryConfigs.canggu);
  return categories.map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;
const config = categoryConfigs.canggu[category];
const categoryVenues = venues.filter(
  (v) => v.location === 'canggu' && v.category === category
);
const order = (venueOrder as Record<string, string[]>)[category] ?? [];
const orderBySub = subOrdersFor(venueOrder as Record<string, unknown>, category);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `${config.title} in Canggu`,
  "description": `${config.description}. Find the best ${category} spots in Canggu, Bali.`,
  "numberOfItems": categoryVenues.length,
  "itemListElement": categoryVenues.map((venue, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "LocalBusiness",
      "name": venue.name,
      "description": venue.description,
      "image": venue.imageUrl,
      "url": venue.googleMapsUrl,
      ...(venue.priceRange && { "priceRange": venue.priceRange }),
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Canggu",
        "addressRegion": "Bali",
        "addressCountry": "ID",
      },
    },
  })),
};
---

<BaseLayout
  title={`${config.title} in Canggu - ${config.description} | The Canggupedia`}
  description={`${config.description}. Find the best ${category} spots in Canggu, Bali.`}
  structuredData={structuredData}
>
  <VenueGrid
    client:load
    venues={categoryVenues}
    config={config}
    order={order}
    orderBySub={orderBySub}
    category={category}
    location="canggu"
    backHref="/canggu"
    backLabel="Back to Canggu"
    bgGradient="from-amber-50 to-orange-50"
  />
</BaseLayout>
