---
import BaseLayout from '../../layouts/BaseLayout.astro';

const categories = [
  {
    title: 'FOOD',
    description: 'Brunch, Dinner & Authentic Cuisine',
    href: '/canggu/food',
    gradient: 'from-amber-400 to-orange-500',
    subcategories: ['Brunch', 'Dinner', 'Healthy', 'Authentic'],
    icon: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>',
  },
  {
    title: 'HANGOUT',
    description: 'Bars & Party Spots',
    href: '/canggu/hangout',
    gradient: 'from-pink-500 to-rose-500',
    subcategories: ['Bars', 'Party'],
    icon: '<path d="M8 22h8"/><path d="M7 10h10"/><path d="M12 15v7"/><path d="m19 3-7 8-7-8Z"/>',
  },
  {
    title: 'WELLNESS',
    description: 'Gym, Yoga, Spa & More',
    href: '/canggu/wellness',
    gradient: 'from-green-400 to-teal-500',
    subcategories: ['Gym', 'Boxing', 'Padel', 'Yoga', 'Pilates', 'Spa'],
    icon: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
  },
  {
    title: "WHAT'S ON",
    description: 'Daily Promos & Deals',
    href: '/daily-promos?location=canggu',
    gradient: 'from-purple-500 to-indigo-500',
    subcategories: ['Mon-Sun Specials'],
    icon: '<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>',
  },
  {
    title: 'EVENTS',
    description: 'Upcoming Parties & Festivals',
    href: '/events?location=canggu',
    gradient: 'from-red-500 to-pink-500',
    subcategories: ['Coming Soon'],
    icon: '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
  },
  {
    title: 'HAPPY HOUR',
    description: 'Best Drink Deals',
    href: '/happy-hour?location=canggu',
    gradient: 'from-yellow-400 to-amber-500',
    subcategories: ['Daily Specials'],
    icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  },
  {
    title: 'FUN & FAMILY',
    description: 'Family Activities',
    href: '/canggu/fun-family',
    gradient: 'from-blue-400 to-cyan-500',
    subcategories: ['Waterparks', 'Zoo', 'Activities'],
    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  },
];
---

<BaseLayout
  title="Explore Canggu - Best Restaurants, Bars & Wellness | The Canggupedia"
  description="Discover the best of Canggu - from trendy brunch spots to legendary beach clubs, wellness studios, and nightlife."
>
  <div class="min-h-screen bg-gradient-to-br from-amber-50 to-orange-50">
    <div class="container mx-auto px-4 py-12">
      <div class="text-center mb-12">
        <h1 class="text-5xl md:text-7xl font-display font-bold text-gray-800 mb-4">
          Explore Canggu
        </h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Discover the best of Canggu - from trendy brunch spots to legendary beach clubs
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
        {categories.map((category) => (
          <a href={category.href} class="group">
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden card-hover h-full">
              <div class={`bg-gradient-to-br ${category.gradient} p-6 text-white`}>
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-4">
                  <Fragment set:html={category.icon} />
                </svg>
                <h2 class="text-3xl font-display font-bold mb-2">{category.title}</h2>
                <p class="text-white/90">{category.description}</p>
              </div>
              <div class="p-6">
                <div class="flex flex-wrap gap-2">
                  {category.subcategories.map((sub) => (
                    <span class="bg-gray-100 text-gray-700 px-3 py-1 rounded-full text-sm font-semibold">
                      {sub}
                    </span>
                  ))}
                </div>
                <div class="mt-4 text-sunset-orange font-bold group-hover:translate-x-2 transition-transform inline-block">
                  Explore →
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
