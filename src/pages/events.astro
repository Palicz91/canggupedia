---
import BaseLayout from '../layouts/BaseLayout.astro';
import eventsData from '../data/events.json';
import { upcomingEvents, baliToday, lastDay } from '../lib/events';
import { toHref } from '../lib/links';
import { cdnImage } from '../lib/images';

// Build-time cut. The inline script below repeats it in the browser because the site only
// rebuilds when someone saves in the CMS.
const sortedEvents = upcomingEvents(eventsData.events, baliToday());
---

<BaseLayout
  title="Events in Bali - Parties, Festivals & More | The Canggupedia"
  description="Discover upcoming parties, festivals, and conferences in Canggu and Uluwatu, Bali."
>
  <div class="min-h-screen bg-gradient-to-br from-red-100 to-pink-100">
    <div class="container mx-auto px-4 py-12">
      <div class="text-center mb-12">
        <h1 class="text-5xl md:text-6xl font-display font-bold text-gray-800 mb-4">
          Events Coming Soon
        </h1>
        <p id="events-subtitle" class="text-xl text-gray-600">
          Upcoming Parties, Festivals & Conferences
        </p>
      </div>

      {sortedEvents.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
          {sortedEvents.map((event) => (
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden card-hover event-card" data-location={event.location} data-date={lastDay(event)}>
              <div class="relative h-56">
                <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-amber-100 to-orange-100" aria-hidden="true">
                  <img src="/images/pediafamlogo.webp" alt="" class="w-24 max-w-[60%] opacity-40" />
                </div>
                {event.imageUrl && (
                  <button
                    type="button"
                    class="image-zoom relative block w-full h-full cursor-zoom-in"
                    data-zoom={cdnImage(event.imageUrl, 1200)}
                    aria-label={`Show the full picture: ${event.title}`}
                  >
                    <img
                      src={cdnImage(event.imageUrl, 800)}
                      alt={event.title}
                      class="w-full h-full object-cover"
                      loading="lazy"
                      onerror="this.parentElement.remove()"
                    />
                  </button>
                )}
              </div>
              <div class="p-6">
                <h3 class="font-display font-bold text-2xl text-gray-800 mb-3">
                  {event.title}
                </h3>

                <div class="space-y-2 mb-4">
                  <div class="flex items-center space-x-2 text-gray-600">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sunset-orange"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                    <span class="font-semibold">
                      {new Date(event.date).toLocaleDateString('en-US', {
                        month: 'long',
                        day: 'numeric',
                        year: 'numeric',
                      })}
                    </span>
                  </div>

                  {event.venue && (
                    <div class="flex items-center space-x-2 text-gray-600">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sunset-orange"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
                      <span>{event.venue}</span>
                    </div>
                  )}

                  {event.price && (
                    <div class="flex items-center space-x-2 text-gray-600">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sunset-orange"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/></svg>
                      <span class="font-semibold">{event.price}</span>
                    </div>
                  )}
                </div>

                <p class="text-gray-600 mb-6 line-clamp-3">
                  {event.description}
                </p>

                {toHref(event.ticketUrl) && (
                  <a
                    href={toHref(event.ticketUrl)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block w-full bg-gradient-tropical text-white py-3 px-6 rounded-xl font-bold hover:shadow-lg transition-all hover:scale-105 text-center"
                  >
                    Buy Tickets
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      ) : null}

      <div id="empty-state" class="text-center py-16" hidden={sortedEvents.length > 0}>
        <p id="empty-state-text" class="text-xl text-gray-600">No upcoming events right now. Check back soon.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { baliToday } from '../lib/events';

  const params = new URLSearchParams(window.location.search);
  const location = params.get('location');
  if (location) {
    const name = location.charAt(0).toUpperCase() + location.slice(1);
    const subtitle = document.getElementById('events-subtitle');
    if (subtitle) subtitle.textContent = `${name} - Upcoming Parties, Festivals & Conferences`;
  }

  const today = baliToday();
  let upcoming = 0;
  let shown = 0;
  document.querySelectorAll<HTMLElement>('.event-card').forEach((card) => {
    const date = card.getAttribute('data-date') || '';
    if (date && date < today) {
      card.style.display = 'none';
      return;
    }
    upcoming++;
    if (location && card.getAttribute('data-location') !== location) {
      card.style.display = 'none';
      return;
    }
    shown++;
  });

  const empty = document.getElementById('empty-state');
  const emptyText = document.getElementById('empty-state-text');
  if (empty && emptyText) {
    if (shown === 0) {
      emptyText.textContent = upcoming > 0 ? 'Nothing in this area yet.' : 'No upcoming events right now. Check back soon.';
      empty.hidden = false;
    } else {
      empty.hidden = true;
    }
  }
</script>
