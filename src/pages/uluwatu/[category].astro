---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VenueGrid from '../../components/VenueGrid.tsx';
import venues from '../../data/venues.json';
import { categoryConfigs } from '../../data/category-config';

export function getStaticPaths() {
  const categories = Object.keys(categoryConfigs.uluwatu);
  return categories.map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;
const config = categoryConfigs.uluwatu[category];
const categoryVenues = venues.filter(
  (v) => v.location === 'uluwatu' && v.category === category
);
---

<BaseLayout
  title={`${config.title} in Uluwatu - ${config.description} | The Canggupedia`}
  description={`${config.description}. Find the best ${category} spots in Uluwatu, Bali.`}
>
  <VenueGrid
    client:load
    venues={categoryVenues}
    config={config}
    category={category}
    location="uluwatu"
    backHref="/uluwatu"
    backLabel="Back to Uluwatu"
    bgGradient="from-blue-50 to-cyan-50"
  />
</BaseLayout>
